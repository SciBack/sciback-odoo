<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cneb_competency_tree" model="ir.ui.view">
        <field name="name">cneb.competency.tree</field>
        <field name="model">cneb.competency</field>
        <field name="arch" type="xml">
            <tree string="Competencias CNEB">
                <field name="sequence" widget="handle"/>
                <field name="area_id"/>
                <field name="level"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_cneb_competency_form" model="ir.ui.view">
        <field name="name">cneb.competency.form</field>
        <field name="model">cneb.competency</field>
        <field name="arch" type="xml">
            <form string="Competencia CNEB">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="area_id"/>
                            <field name="level"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cneb_competency_search" model="ir.ui.view">
        <field name="name">cneb.competency.search</field>
        <field name="model">cneb.competency</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="area_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_area" string="Área" context="{'group_by':'area_id'}"/>
                    <filter name="group_level" string="Nivel" context="{'group_by':'level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cneb_competency" model="ir.actions.act_window">
        <field name="name">Competencias</field>
        <field name="res_model">cneb.competency</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cneb_competency_search"/>
    </record>

</odoo>
