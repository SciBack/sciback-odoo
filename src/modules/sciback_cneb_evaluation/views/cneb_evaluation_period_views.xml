<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cneb_evaluation_period_tree" model="ir.ui.view">
        <field name="name">cneb.evaluation.period.tree</field>
        <field name="model">cneb.evaluation.period</field>
        <field name="arch" type="xml">
            <tree string="Periodos de evaluación">
                <field name="sequence" widget="handle"/>
                <field name="academic_year_id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-muted="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="view_cneb_evaluation_period_form" model="ir.ui.view">
        <field name="name">cneb.evaluation.period.form</field>
        <field name="model">cneb.evaluation.period</field>
        <field name="arch" type="xml">
            <form string="Periodo de evaluación">
                <header>
                    <button name="action_open" type="object" string="Abrir"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Cerrar"
                            invisible="state != 'open'"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="academic_term_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cneb_evaluation_period" model="ir.actions.act_window">
        <field name="name">Periodos de evaluación</field>
        <field name="res_model">cneb.evaluation.period</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
