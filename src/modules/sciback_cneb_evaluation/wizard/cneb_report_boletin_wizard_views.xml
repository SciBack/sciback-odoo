<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cneb_report_boletin_wizard_form" model="ir.ui.view">
        <field name="name">cneb.report.boletin.wizard.form</field>
        <field name="model">cneb.report.boletin.wizard</field>
        <field name="arch" type="xml">
            <form string="Boletín de Notas CNEB">
                <sheet>
                    <div class="oe_title">
                        <h1>Generar boletín de notas</h1>
                        <p class="text-muted">
                            Emite el boletín de un periodo o el consolidado anual,
                            por estudiante o por toda la sección.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="batch_id"/>
                        </group>
                        <group>
                            <field name="scope" widget="radio"/>
                            <field name="period_id"
                                   invisible="scope != 'period'"
                                   required="scope == 'period'"/>
                        </group>
                    </group>
                    <group>
                        <field name="student_ids" widget="many2many_tags"
                               placeholder="Vacío = toda la sección"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_boletin" type="object"
                            string="Imprimir boletín" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cneb_report_boletin_wizard" model="ir.actions.act_window">
        <field name="name">Boletín de Notas</field>
        <field name="res_model">cneb.report.boletin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
