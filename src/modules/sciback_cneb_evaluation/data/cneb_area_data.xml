            <field name="name">Comunicación</field>
            <field name="code">SEC_COM</field>
            <field name="siagie_abbr">COMU_LM</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_matematica" model="cneb.area">
            <field name="name">Matemática</field>
            <field name="code">SEC_MAT</field>
            <field name="siagie_abbr">MATE</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_ciencias_sociales" model="cneb.area">
            <field name="name">Ciencias Sociales</field>
            <field name="code">SEC_CCSS</field>
            <field name="siagie_abbr">CCSS</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_dpcc" model="cneb.area">
            <field name="name">Desarrollo Personal, Ciudadanía y Cívica</field>
            <field name="code">SEC_DPCC</field>
            <field name="siagie_abbr">DPCC</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_ciencia_tecnologia" model="cneb.area">
            <field name="name">Ciencia y Tecnología</field>
            <field name="code">SEC_CYT</field>
            <field name="siagie_abbr">CTA</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_ept" model="cneb.area">
            <field name="name">Educación para el Trabajo</field>
            <field name="code">SEC_EPT</field>
            <field name="siagie_abbr">EPT</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_arte_cultura" model="cneb.area">
            <field name="name">Arte y Cultura</field>
            <field name="code">SEC_ART</field>
            <field name="siagie_abbr">ARTE</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_educacion_fisica" model="cneb.area">
            <field name="name">Educación Física</field>
            <field name="code">SEC_EF</field>
            <field name="siagie_abbr">EDFI</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_educacion_religiosa" model="cneb.area">
            <field name="name">Educación Religiosa</field>
            <field name="code">SEC_REL</field>
            <field name="siagie_abbr">EDRE</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>
        <record id="cneb_area_sec_ingles" model="cneb.area">
            <field name="name">Inglés</field>
            <field name="code">SEC_ING</field>
            <field name="siagie_abbr">INGL</field>
            <field name="level">secundaria</field>
            <field name="grading_type">literal</field>
        </record>

    </data>
</odoo>
